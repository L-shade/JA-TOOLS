<ResourceDictionary x:Class="RevitDwgUnifier.UI.JaTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    JA Tools design system (2026 revision): one look for every window (DWG exporter, tool
    dialogs, results, progress). Warm neutral ground, white cards, one accent colour per ribbon
    group (set per window through the "Ja.Accent" brush), line icons on soft tiles, 8 px spacing
    grid, segmented choices on a grey track, one clear primary action, 12.5 px Segoe UI.
  -->

  <!-- ===== palette ===== -->
  <SolidColorBrush x:Key="Ja.Accent" Color="#1F7A5A"/>
  <SolidColorBrush x:Key="Ja.AccentSoft" Color="#E4F2EC"/>
  <SolidColorBrush x:Key="Ja.Ink" Color="#18212B"/>
  <SolidColorBrush x:Key="Ja.Text" Color="#2E3742"/>
  <SolidColorBrush x:Key="Ja.Muted" Color="#66707C"/>
  <SolidColorBrush x:Key="Ja.Line" Color="#E3E6E1"/>
  <SolidColorBrush x:Key="Ja.InputLine" Color="#CFD4CD"/>
  <SolidColorBrush x:Key="Ja.Surface" Color="#F3F4F1"/>
  <SolidColorBrush x:Key="Ja.Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ja.Field" Color="#EDEFEA"/>
  <SolidColorBrush x:Key="Ja.Hover" Color="#EEF0EC"/>
  <SolidColorBrush x:Key="Ja.Error" Color="#C0392B"/>
  <SolidColorBrush x:Key="Ja.Warn" Color="#B7791F"/>
  <SolidColorBrush x:Key="Ja.Ok" Color="#2E8B57"/>

  <!-- ===== text ===== -->
  <Style x:Key="Ja.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="Ja.Subtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="#E8EEF5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Ja.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource Ja.Muted}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="Ja.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ja.Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Ja.Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ja.Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <!-- ===== containers ===== -->
  <Style x:Key="Ja.CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Ja.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ja.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- ===== buttons ===== -->
  <Style x:Key="Ja.ButtonBase" TargetType="Button">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ja.Ink}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Ja.Primary" TargetType="Button" BasedOn="{StaticResource Ja.ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource Ja.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ja.Secondary" TargetType="Button" BasedOn="{StaticResource Ja.ButtonBase}">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource Ja.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ja.InputLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="Ja.Ghost" TargetType="Button" BasedOn="{StaticResource Ja.ButtonBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Ja.Text}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!-- segmented choice: RadioButtons on a grey track (the selected one is a white tab) -->
  <Style x:Key="Ja.Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="6" Padding="12,6" BorderThickness="1"
                  BorderBrush="Transparent" Background="{StaticResource Ja.Field}">
            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{StaticResource Ja.Text}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#E4E7E1"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ja.Card}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Accent}"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Ja.Ink}"/>
              <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- on/off pill: CheckBox drawn like a segment (several can be on) -->
  <Style x:Key="Ja.Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" CornerRadius="8" Padding="12,6" BorderThickness="1"
                  BorderBrush="{StaticResource Ja.InputLine}" Background="White">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Tick" Text="&#x2713;" FontFamily="Segoe UI Symbol" Margin="0,0,6,0" Foreground="{DynamicResource Ja.Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
              <ContentPresenter x:Name="Cp" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Ja.Text}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ja.Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.AccentSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Accent}"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Ja.Ink}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tabs (implicit): a segmented control on a grey track, as in the Varinha Mágica panel -->
  <Style TargetType="TabItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Padding="13,5" Margin="0,0,3,0" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter x:Name="Cp" ContentSource="Header" TextElement.Foreground="{StaticResource Ja.Text}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#E4E7E1"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ja.Card}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Accent}"/>
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Ja.Ink}"/>
              <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Ja.Field}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
              <TabPanel IsItemsHost="True"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent" Margin="0,10,0,0"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== inputs (implicit) ===== -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ja.InputLine}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,3,0,3"/>
    <Setter Property="Foreground" Value="{StaticResource Ja.Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="MaxWidth" Value="360"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
