<Window x:Class="RevitDwgUnifier.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JA Tools — Exportar Pranchas"
        Width="1080" Height="740" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!--
    Exportar Pranchas (1.14): same functions, lighter layout in the language of the Varinha Mágica panel.
      left  : Pranchas (search, Folhas/Vistas, list)
      right : Formatos (3 toggles) · Destino (always visible: folder + names) · Opções as a segmented
              control (PDF · DWG · DWG único · Avançado) — only the ones the chosen formats use.
    Long explanations moved to tooltips. The theme (JaTheme) is merged in code-behind, so every Ja.*
    reference is a DynamicResource.
  -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ja.Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="24,0,0,8"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <!-- small muted label above a control (as in the Varinha panel) -->
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ja.Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="InlineLbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ja.Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Ja.Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SubHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Ja.Muted}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Ja.Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Ja.Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <!-- thin divider between groups inside a card -->
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Ja.Line}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Margin" Value="0,10,0,10"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3,0,3"/>
      <Setter Property="Foreground" Value="{DynamicResource Ja.Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- token chip ({numero}, {nome}...) -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Padding="7,2,7,3" Background="{DynamicResource Ja.Field}">
              <ContentPresenter TextElement.FontSize="11" TextElement.Foreground="{DynamicResource Ja.Text}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- format toggle: compact card, soft accent when on -->
    <Style x:Key="FormatTile" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Ja.InputLine}" Background="White" Padding="10,9">
              <DockPanel>
                <Border x:Name="Chip" DockPanel.Dock="Left" CornerRadius="6" Width="36" Height="36" Margin="0,0,10,0"
                        Background="{DynamicResource Ja.Field}" VerticalAlignment="Top">
                  <TextBlock x:Name="ChipText" Text="{TemplateBinding Tag}" FontWeight="Bold" FontSize="10.5"
                             Foreground="{DynamicResource Ja.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="Tick" DockPanel.Dock="Right" Text="&#x2713;" FontFamily="Segoe UI Symbol" FontWeight="Bold"
                           Foreground="{DynamicResource Ja.Accent}" VerticalAlignment="Top" Margin="6,0,0,0" Visibility="Hidden"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.AccentSoft}"/>
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Ja.Accent}"/>
                <Setter TargetName="ChipText" Property="Foreground" Value="White"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- options: tabs are the theme's segmented control (JaTheme) -->

    <!-- search box with placeholder -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{DynamicResource Ja.Field}" CornerRadius="8">
              <Grid>
                <TextBlock x:Name="Ph" Text="Buscar pelo nome ou número  (Ctrl+F)" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ja.Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Folhas / Vistas: segments that can both be on -->
    <Style x:Key="FilterSeg" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" CornerRadius="6" Padding="10,4" Margin="0,0,3,0" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter x:Name="Cp" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Ja.Muted}" TextElement.FontSize="11.5"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E4E7E1"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.Card}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ja.Accent}"/>
                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Ja.Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Background="{DynamicResource Ja.Surface}">
    <!-- ============================== HEADER ============================== -->
    <Grid DockPanel.Dock="Top" Margin="22,16,22,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Exportar Pranchas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Ink}"/>
        <TextBlock Foreground="{DynamicResource Ja.Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                   Text="PDF, DWG único (um layout por folha, na escala do Revit), DWG por prancha e PNG, de uma vez."/>
      </StackPanel>
      <Button Grid.Column="2" Content="?" Style="{DynamicResource Ja.Ghost}" Click="OnHelp" VerticalAlignment="Center" FontWeight="SemiBold"
              ToolTip="Central de Ajuda (F1)"/>
    </Grid>

    <!-- ============================== FOOTER ============================== -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Ja.Card}" BorderBrush="{DynamicResource Ja.Line}" BorderThickness="0,1,0,0" Padding="22,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancelar" IsCancel="True" Style="{DynamicResource Ja.Ghost}" MinWidth="88" Margin="0,0,8,0"/>
          <Button Content="{Binding ExportButtonText}" IsDefault="True" Click="OnExport" Style="{DynamicResource Ja.Primary}" MinWidth="190"
                  IsEnabled="{Binding CanExport}" ToolTip="Enter"/>
        </StackPanel>
        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Ja.Ok}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanExport}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource Ja.Warn}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource Ja.Text}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- ============================== BODY ============================== -->
    <Grid Margin="22,8,22,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="320"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1.3*" MinWidth="460"/>
      </Grid.ColumnDefinitions>

      <!-- ===================== PRANCHAS ===================== -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2,8,3" Background="{DynamicResource Ja.AccentSoft}" VerticalAlignment="Center"
                    ToolTip="Itens marcados / total">
              <TextBlock Text="{Binding SelectionBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Accent}"/>
            </Border>
            <TextBlock Text="Pranchas" Style="{StaticResource Head}"/>
          </DockPanel>

          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" Background="{DynamicResource Ja.Field}" CornerRadius="8" Padding="3" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal">
                <CheckBox Content="Folhas" IsChecked="{Binding ShowSheets}" Style="{StaticResource FilterSeg}" ToolTip="Mostrar folhas na lista"/>
                <CheckBox Content="Vistas" IsChecked="{Binding ShowViews}" Style="{StaticResource FilterSeg}" ToolTip="Mostrar vistas avulsas na lista"/>
              </StackPanel>
            </Border>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="Shift+clique: intervalo" FontSize="11" Foreground="{DynamicResource Ja.Muted}" VerticalAlignment="Center"
                       ToolTip="Shift+clique marca um intervalo; Ctrl+clique alterna um item. Pranchas selecionadas no Navegador de Projeto já vêm marcadas."/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Marcar visíveis" Command="{Binding SelectAllVisibleCommand}" Style="{DynamicResource Ja.Ghost}" Margin="0,0,4,0"
                      ToolTip="Marca tudo o que aparece na lista (respeita a busca e os filtros)"/>
              <Button Content="Limpar" Command="{Binding ClearCommand}" Style="{DynamicResource Ja.Ghost}" ToolTip="Desmarca tudo"/>
            </StackPanel>
          </DockPanel>

          <ListBox ItemsSource="{Binding ItemsView}" BorderThickness="0" Background="Transparent"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,10,0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Ja.Muted}"/>
                      <TextBlock Text="{Binding ItemCount, StringFormat='  {0}'}" FontSize="11" Foreground="{DynamicResource Ja.Muted}" Opacity="0.7"/>
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" CornerRadius="6" Padding="6,3" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ja.Hover}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="0" Click="OnItemClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Ja.Text}"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Ja.Muted}" Margin="8,0,0,0" FontSize="11"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===================== RIGHT SIDE ===================== -->
      <DockPanel Grid.Column="2">

        <!-- FORMATOS -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-8,10">
          <CheckBox Style="{StaticResource FormatTile}" Tag="PDF" IsChecked="{Binding ExportPdf}"
                    ToolTip="Gerado direto pelo Revit, com as cores escolhidas em Opções › PDF.">
            <StackPanel>
              <TextBlock Text="PDF" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Ink}"/>
              <TextBlock Text="Um por prancha ou único" FontSize="11" Foreground="{DynamicResource Ja.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </CheckBox>
          <CheckBox Style="{StaticResource FormatTile}" Tag="DWG" IsChecked="{Binding ExportDwgUnified}"
                    ToolTip="Um só DWG: o modelo no Model Space e um layout por folha, idêntico ao Revit e na mesma escala. Usa o AutoCAD instalado.">
            <StackPanel>
              <TextBlock Text="DWG único" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Ink}"/>
              <TextBlock Text="Um layout por folha" FontSize="11" Foreground="{DynamicResource Ja.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </CheckBox>
          <CheckBox Style="{StaticResource FormatTile}" Tag="DWG+" IsChecked="{Binding ExportDwgPerSheet}"
                    ToolTip="Um DWG para cada item marcado, com os mesmos ajustes e opções do DWG único (layout igual à folha, padrão JA, cores ByLayer...). Usa o AutoCAD instalado; sem ele, sai a exportação simples do Revit.">
            <StackPanel>
              <TextBlock Text="DWG por prancha" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Ink}"/>
              <TextBlock Text="Um arquivo por item" FontSize="11" Foreground="{DynamicResource Ja.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </CheckBox>
          <CheckBox Style="{StaticResource FormatTile}" Tag="PNG" IsChecked="{Binding ExportPng}"
                    ToolTip="Imagem de cada folha ou vista marcada, com fundo transparente ou branco (antes: Exportar Vistas).">
            <StackPanel>
              <TextBlock Text="PNG" FontWeight="SemiBold" Foreground="{DynamicResource Ja.Ink}"/>
              <TextBlock Text="Imagem, fundo transparente" FontSize="11" Foreground="{DynamicResource Ja.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </CheckBox>
        </UniformGrid>

        <!-- DESTINO (always needed) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Destino" Style="{StaticResource Head}" Margin="0,0,0,10"/>
            <TextBlock Text="Pasta" Style="{StaticResource Lbl}"/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Procurar…" Style="{DynamicResource Ja.Secondary}" Padding="10,4" Click="OnBrowseFolder" Margin="6,0,0,0"/>
              <TextBox x:Name="FolderBox" Text="{Binding Settings.OutputFolder}" ToolTip="Todos os arquivos vão para esta pasta (criada se não existir)."/>
            </DockPanel>

            <StackPanel Visibility="{Binding UsesPattern, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
              <TextBlock Text="Nome de cada arquivo" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="PatternBox" Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Usado nos PDFs separados e nos DWGs por prancha. Clique nas variáveis para inserir."/>
              <WrapPanel Margin="0,6,0,0">
                <Button Style="{StaticResource Chip}" Content="{}{numero}" Tag="{}{numero}" Click="OnToken" ToolTip="Número da folha"/>
                <Button Style="{StaticResource Chip}" Content="{}{nome}" Tag="{}{nome}" Click="OnToken" ToolTip="Nome da folha ou vista"/>
                <Button Style="{StaticResource Chip}" Content="{}{revisao}" Tag="{}{revisao}" Click="OnToken" ToolTip="Revisão atual da folha"/>
                <Button Style="{StaticResource Chip}" Content="{}{projeto}" Tag="{}{projeto}" Click="OnToken" ToolTip="Nome do projeto"/>
                <Button Style="{StaticResource Chip}" Content="{}{codigo}" Tag="{}{codigo}" Click="OnToken" ToolTip="Número do projeto"/>
                <Button Style="{StaticResource Chip}" Content="{}{data}" Tag="{}{data}" Click="OnToken" ToolTip="Data de hoje (aaaa-mm-dd)"/>
              </WrapPanel>
              <TextBlock Text="{Binding PatternPreview}" FontSize="11" Foreground="{DynamicResource Ja.Accent}"/>
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Visibility="{Binding PdfCombine, Converter={StaticResource BoolVis}}">
                <StackPanel Visibility="{Binding ExportPdf, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                  <TextBlock Text="Nome do PDF único" Style="{StaticResource Lbl}"/>
                  <TextBox Text="{Binding PdfCombinedName}" ToolTip="Variáveis: {projeto} {codigo} {data}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Visibility="{Binding ExportDwgUnified, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                <TextBlock Text="Nome do DWG único" Style="{StaticResource Lbl}"/>
                <TextBox Text="{Binding Settings.OutputFileName}" ToolTip="Sem extensão. Vazio = nome do projeto."/>
              </StackPanel>
            </Grid>

            <CheckBox Content="Sobrescrever arquivos que já existem" IsChecked="{Binding Settings.AllowOverwrite}"
                      ToolTip="Desmarcado: o DWG único ganha um nome numerado se já existir. Um arquivo aberto no AutoCAD nunca é sobrescrito."/>
          </StackPanel>
        </Border>

        <!-- OPÇÕES (only what the chosen formats use) -->
        <TabControl x:Name="Tabs" Visibility="{Binding AnyFormat, Converter={StaticResource BoolVis}}">

          <!-- PDF -->
          <TabItem Header="PDF" Visibility="{Binding ExportPdf, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox Content="Juntar tudo num PDF único" IsChecked="{Binding PdfCombine}"
                            ToolTip="As pranchas entram na ordem da lista; o nome fica em Destino. Desmarcado: um PDF por item."/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Cores" Style="{StaticResource InlineLbl}"/>
                    <ComboBox ItemsSource="{Binding PdfColorChoices}" SelectedIndex="{Binding PdfColorIndex}" MinWidth="180"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>

          <!-- DWG (both kinds) -->
          <!-- PNG -->
          <TabItem Header="PNG" Visibility="{Binding ExportPng, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Largura da imagem (pixels)" Style="{StaticResource Lbl}"/>
                  <TextBox Text="{Binding PngPixels}" Width="110" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="0,0,0,10"
                           ToolTip="4000 px serve para pranchas A1 e apresentações; aumente para impressões grandes (200 a 15000)."/>
                  <CheckBox Content="Fundo transparente (o branco vira transparente)" IsChecked="{Binding PngTransparent}"
                            ToolTip="As bordas suavizadas ficam com transparência proporcional: as linhas continuam lisas sobre qualquer fundo."/>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="DWG" Visibility="{Binding AnyDwg, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="As opções das abas DWG, Layouts e model e Avançado valem igual para o DWG único e para o DWG por prancha: cada prancha passa pelo mesmo ajuste no AutoCAD." TextWrapping="Wrap" FontSize="11" Foreground="#5B6772" Margin="0,0,0,8"/>
                  <TextBlock Text="Configuração DWG do Revit" Style="{StaticResource Lbl}"/>
                  <ComboBox ItemsSource="{Binding ExportSetups}" SelectedItem="{Binding Settings.ExportSetupName}"
                            ToolTip="Define layers, cores e espessuras (Arquivo › Exportar › Opções › Configurações de DWG/DXF). Vale para os dois tipos de DWG."/>

                  <CheckBox Content="Cor de todos os objetos ByLayer" IsChecked="{Binding Merge.ColorsByLayer}" Margin="0,8,0,0"
                            ToolTip="Todos os elementos (inclusive dentro dos blocos, atributos e linhas de cota) ficam com a cor da sua layer; sobreposições de cor do Revit são removidas. O texto das cotas segue a cor escolhida em Layouts. Precisa do AutoCAD instalado."/>
                  <CheckBox Content="Layer das viewports não imprime" IsChecked="{Binding Merge.ViewportsNoPlot}"
                            ToolTip="A layer das viewports dos layouts fica marcada como “não imprimir”. Viewports numa layer usada por outros objetos (ex.: 0) vão para a layer JA - VIEWPORT."/>

                  <Border Style="{StaticResource Divider}"/>
                  <CheckBox x:Name="JaStdBox" Content="Padrão JA: pilares, áreas e instalações" IsChecked="{Binding Merge.JaStandards}" FontWeight="SemiBold"
                            ToolTip="Pilares, pilares estruturais e colunas (blocos no Revit) são explodidos e a hachura vai para a layer indicada. Os textos de PD e de área dos ambientes vão para a layer de área; o nome do ambiente não muda. Precisa do AutoCAD instalado."/>
                  <Grid Margin="24,6,0,0" IsEnabled="{Binding IsChecked, ElementName=JaStdBox}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Hachura dos pilares" Style="{StaticResource InlineLbl}" Margin="0,0,10,6"/>
                    <TextBox Grid.Column="1" Text="{Binding Merge.ColumnHatchLayer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                             ToolTip="Layer das hachuras dos pilares, pilares estruturais e colunas"/>
                    <TextBlock Grid.Column="2" Text="Cor" Style="{StaticResource InlineLbl}" Margin="10,0,6,6"/>
                    <TextBox Grid.Column="3" Text="{Binding Merge.ColumnHatchColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                             ToolTip="Índice de cor do AutoCAD (1 a 255)"/>
                    <TextBlock Grid.Row="1" Text="PD e área" Style="{StaticResource InlineLbl}" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Merge.AreaTextLayer, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Layer dos textos de pé-direito (PD = 2,80) e de área (12,50 m²) das etiquetas de ambiente"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Cor" Style="{StaticResource InlineLbl}" Margin="10,0,6,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Merge.AreaTextColor, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Índice de cor do AutoCAD (1 a 255)"/>
                  </Grid>
                  <CheckBox x:Name="InstBox" Margin="24,10,0,0" IsChecked="{Binding Merge.InstallationLayers}"
                            IsEnabled="{Binding IsChecked, ElementName=JaStdBox}"
                            Content="Notas e etiquetas de instalações nas layers JA - INST_…"
                            ToolTip="Notas: pela disciplina no nome do tipo de texto (ex.: INST_GAS 2,5mm, Texto Elétrica). Etiquetas: pelo nome da família/tipo, senão pelo sistema ou nome do elemento, senão pela categoria. Luminárias vão inteiras para JA - INST_ILUM. Notas sem disciplina ficam onde estão; famílias de instalações e mobiliário continuam como blocos."/>
                  <DataGrid Margin="48,6,0,0" ItemsSource="{Binding Merge.InstallationLayerTable}" AutoGenerateColumns="False"
                            CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal" MaxHeight="210" RowHeight="24" BorderBrush="{DynamicResource Ja.Line}"
                            HorizontalGridLinesBrush="{DynamicResource Ja.Line}" Background="White"
                            IsEnabled="{Binding IsChecked, ElementName=InstBox}"
                            Visibility="{Binding IsChecked, ElementName=InstBox, Converter={StaticResource BoolVis}}"
                            ToolTip="Clique duas vezes para mudar o nome da layer, a cor (ID do AutoCAD, 1 a 255) ou o tipo de linha.">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="*"/>
                      <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="56"/>
                      <DataGridTextColumn Header="Tipo de linha" Binding="{Binding Linetype}" Width="110"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>

          <!-- DWG único: versão, unidades, coordenadas, layouts, vistas avulsas, imagens -->
          <TabItem Header="Layouts e model" Visibility="{Binding AnyDwg, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="ARQUIVO" Style="{StaticResource SubHead}"/>
                  <UniformGrid Columns="3" Margin="0,0,-10,0">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Versão" Style="{StaticResource Lbl}"/>
                      <ComboBox ItemsSource="{Binding DwgVersions}" SelectedItem="{Binding Settings.DwgVersion}"
                                ToolTip="2018 abre em qualquer AutoCAD de 2018 em diante. Use versões antigas só se o destinatário pedir."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Unidade do model" Style="{StaticResource Lbl}"/>
                      <ComboBox ItemsSource="{Binding TargetUnits}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.TargetUnit}"
                                ToolTip="Ex.: model em Metro → 1 unidade = 1 m."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Unidade do papel" Style="{StaticResource Lbl}"/>
                      <ComboBox ItemsSource="{Binding PaperUnitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Merge.PaperUnits}"
                                ToolTip="Ex.: papel em Milímetro → A4 = 210 × 297. As viewports mantêm a escala do Revit (1:50 → escala 20)."/>
                    </StackPanel>
                  </UniformGrid>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="MODEL SPACE" Style="{StaticResource SubHead}"/>
                  <CheckBox Content="Coordenadas compartilhadas (em vez da origem interna)" IsChecked="{Binding UseSharedCoordinates}"/>
                  <CheckBox x:Name="ModelSheetsBox" Content="Model montado como as folhas (carimbo + vistas, lado a lado)" IsChecked="{Binding Merge.ModelSheets}"
                            ToolTip="Cada prancha aparece inteira no model, na ordem, com o nome em cima, na escala real da vista principal; os layouts olham para essas réplicas. Sem ele, cada folha ocupa uma área própria perto de 0,0 só com as vistas."/>
                  <StackPanel Orientation="Horizontal" Margin="24,2,0,4" IsEnabled="{Binding IsChecked, ElementName=ModelSheetsBox}">
                    <TextBlock Text="Folhas por linha" Style="{StaticResource InlineLbl}"/>
                    <TextBox Width="50" Text="{Binding Merge.ModelSheetsPerRow, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <CheckBox Content="Manter as coordenadas reais (sem organizar lado a lado)" IsChecked="{Binding UseTrueCoordinates}"
                            ToolTip="Ignorado com o model montado como as folhas."/>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="LAYOUTS" Style="{StaticResource SubHead}"/>
                  <CheckBox Content="Abas só com o número da folha (ex.: A102)" IsChecked="{Binding Settings.SheetTabNameIsNumber}"
                            ToolTip="Desmarcado: “A102 - Nome da folha”. Cada folha vira um layout idêntico à folha do Revit."/>
                  <CheckBox Content="Mesmo tamanho para todas as viewports da folha" IsChecked="{Binding Merge.UniformViewportSize}"
                            ToolTip="Viewports bem maiores que o desenho recebem o tamanho da menor da folha. Escala e posição não mudam."/>
                  <CheckBox Content="Caderno de esquadrias: uma aba por viewport (nome = marca)" IsChecked="{Binding Settings.SplitSheetsByViewport}"
                            ToolTip="Cada viewport ganha sua aba com o carimbo da folha, centralizada. Nome = Marca de tipo (senão Marca, depois nome da vista)."/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Cor do texto das cotas" Style="{StaticResource InlineLbl}"/>
                    <TextBox Width="56" Text="{Binding Merge.DimTextColorIndex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                             ToolTip="Índice do AutoCAD 1–255 (padrão 140). 0 = cor do Revit."/>
                  </StackPanel>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="VISTAS FORA DE FOLHAS" Style="{StaticResource SubHead}"/>
                  <DockPanel>
                    <TextBlock Text="Carimbo" Style="{StaticResource InlineLbl}"/>
                    <ComboBox ItemsSource="{Binding TitleBlocks}" SelectedItem="{Binding SelectedTitleBlock}"
                              ToolTip="Carimbo usado no layout de cada vista que não está numa folha."/>
                  </DockPanel>
                  <CheckBox Margin="0,6,0,3" Content="Menor tamanho desse carimbo que caiba" IsChecked="{Binding Settings.AutoFitTitleBlock}"/>
                  <CheckBox Content="Ignorar vistas que já estão numa folha marcada" IsChecked="{Binding Settings.SkipViewsAlreadyOnSelectedSheets}"/>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="IMAGENS" Style="{StaticResource SubHead}"/>
                  <CheckBox Content="Incorporar logos e figuras no DWG (OLE), em segundo plano" IsChecked="{Binding Settings.EmbedImagesAsOle}"
                            ToolTip="O DWG fica independente, sem pasta de imagens. Uma janela do AutoCAD abre por alguns segundos e usa a área de transferência: não copie/cole nesse meio tempo. Se falhar, as imagens ficam vinculadas à pasta “&lt;nome&gt;_imagens”."/>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>

          <!-- Avançado (DWG único) -->
          <TabItem Header="Avançado" Visibility="{Binding AnyDwg, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="CORREÇÕES AUTOMÁTICAS" Style="{StaticResource SubHead}"/>
                  <UniformGrid Columns="2">
                    <CheckBox Content="Região de recorte ligada" IsChecked="{Binding Settings.EnforceCropRegions}" ToolTip="Força a região de recorte (evita geometria solta)"/>
                    <CheckBox Content="Recorte de anotação ligado" IsChecked="{Binding Settings.EnforceAnnotationCrop}"/>
                    <CheckBox Content="Ocultar contorno do recorte" IsChecked="{Binding Settings.HideCropBoundary}"/>
                    <CheckBox Content="Apagar o que está fora das viewports" IsChecked="{Binding Merge.CullOutsideViewports}"/>
                    <CheckBox Content="Remover entidades duplicadas" IsChecked="{Binding Merge.RemoveDuplicateEntities}"/>
                    <CheckBox Content="Vincular xrefs restantes" IsChecked="{Binding Merge.BindXrefs}" ToolTip="Com nomes de layer limpos"/>
                    <CheckBox Content="Explodir blocos anônimos *U" IsChecked="{Binding Merge.ExplodeAnonymousBlocks}"/>
                    <CheckBox Content="Carimbo começando em 0,0" IsChecked="{Binding Merge.NormalizePaperOrigin}"/>
                    <CheckBox Content="Limpar (purge) o que não é usado" IsChecked="{Binding Merge.PurgeUnused}"/>
                  </UniformGrid>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="TEXTOS, FONTES E HACHURAS" Style="{StaticResource SubHead}"/>
                  <CheckBox Content="Texto exato (manter as quebras de linha do Revit)" IsChecked="{Binding Settings.ExactText}"/>
                  <CheckBox Content="Reparar estilos de texto (SHX ausente, acentos)" IsChecked="{Binding Merge.RepairTextStyles}"/>
                  <CheckBox x:Name="MapFonts" Content="Substituir fontes que faltam neste PC" IsChecked="{Binding Settings.MapMissingFonts}"/>
                  <StackPanel Margin="24,2,0,6" Visibility="{Binding IsChecked, ElementName=MapFonts, Converter={StaticResource BoolVis}}">
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Fonte reserva" Style="{StaticResource InlineLbl}"/>
                      <TextBox Text="{Binding Settings.FallbackFont}"/>
                    </DockPanel>
                    <TextBlock Text="Mapa de fontes (uma por linha: fonte do Revit=fonte do CAD)" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding FontMapText}" AcceptsReturn="True" Height="54" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                  </StackPanel>
                  <CheckBox Content="Ajustar hachuras densas demais" IsChecked="{Binding Merge.NormalizeHatches}"/>
                  <TextBlock Text="Mapeamento de hachuras (opcional)" Style="{StaticResource Lbl}" Margin="0,6,0,3"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Style="{DynamicResource Ja.Secondary}" Padding="10,4" Click="OnBrowsePat" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding Settings.HatchPatternFile}" ToolTip="Arquivo .txt/.pat que troca hachuras do Revit por padrões do AutoCAD."/>
                  </DockPanel>

                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Text="MOTOR DE UNIÃO (AUTOCAD CORE CONSOLE)" Style="{StaticResource SubHead}"/>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Procurar…" Style="{DynamicResource Ja.Secondary}" Padding="10,4" Click="OnBrowseConsole" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding Settings.CoreConsolePath}" ToolTip="accoreconsole.exe. Vazio = AutoCAD mais recente encontrado neste PC."/>
                  </DockPanel>
                  <CheckBox Content="Manter arquivos intermediários (diagnóstico)" IsChecked="{Binding Settings.KeepIntermediateFiles}"/>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
