<Project>
  <!--
    JA para Revit: one repository, one version, one installer, two add-ins (two ribbon tabs):
      src\JAEsquadrias.Revit      -> aba "JA Famílias"   (JAEsquadrias.Revit.dll)
      src\RevitDwgUnifier.Revit   -> aba "JA Tools"      (RevitDwgUnifier.Revit.dll)
      src\RevitDwgUnifier.AcadMerge  motor de união do DWG (AutoCAD)
      src\Comum                   código comum aos dois add-ins (compilado dentro de cada DLL)
    Each add-in multi-targets by HOST version:
      - Revit 2024            -> .NET Framework 4.8
      - Revit 2025 / 2026     -> .NET 8 (net8.0-windows), or what the installed Revit uses
      - Revit 2027            -> .NET 10 (net10.0-windows)
    Pick the host with  -p:RevitVersion=2024|2025|2026|2027
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>JA Arquitetos Associados</Company>
    <Product>JA para Revit</Product>
    <Version>2.6.0</Version>
    <Deterministic>true</Deterministic>
    <!-- Revit/AutoCAD DLLs reference WindowsDesktop facades (System.Drawing, WindowsBase,
         Microsoft.VisualBasic) with newer versions than the reference pack: harmless, silence it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Host API assemblies are always provided by the host process: never copy them. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
